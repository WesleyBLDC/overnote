# The repo's formatting, for editors. Prettier (`npx prettier --write .`) has the final say on the files it formats.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

# Swift follows the helper's existing four space indent.
[*.swift]
indent_size = 4

# Two trailing spaces are a Markdown line break.
[*.md]
trim_trailing_whitespace = false
max_line_length = off
