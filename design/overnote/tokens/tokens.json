{
  "name": "Overnote Graphite",
  "colors": {
    "--bg-panel": {
      "dark": "#18181A",
      "light": "#FBFBFC",
      "use": "Note panel"
    },
    "--bg-raised": {
      "dark": "#232326",
      "light": "#FFFFFF",
      "use": "Menus, popovers, pinned island"
    },
    "--bg-sunken": {
      "dark": "#111113",
      "light": "#F1F1F3",
      "use": "Terminal drawer, code blocks"
    },
    "--bg-code": {
      "dark": "#26262A",
      "light": "#EDEDF0",
      "use": "Inline code chip"
    },
    "--border": {
      "dark": "rgba(255,255,255,0.08)",
      "light": "rgba(0,0,0,0.08)",
      "use": "Hairlines, dividers"
    },
    "--border-strong": {
      "dark": "rgba(255,255,255,0.14)",
      "light": "rgba(0,0,0,0.14)",
      "use": "Panel edge, chips"
    },
    "--text": {
      "dark": "#EDEDEF",
      "light": "#1A1A1D",
      "use": "Body \u00b7 15.2 / 16.8:1"
    },
    "--text-secondary": {
      "dark": "#A1A1A8",
      "light": "#5F6168",
      "use": "Icons, labels \u00b7 6.9 / 6.0:1"
    },
    "--text-tertiary": {
      "dark": "#8E8E95",
      "light": "#6B6E75",
      "use": "Counts, hints \u00b7 5.4 / 4.9:1"
    },
    "--accent": {
      "dark": "#E4E4E7",
      "light": "#27272A",
      "use": "Checked boxes, numbers"
    },
    "--accent-strong": {
      "dark": "#FFFFFF",
      "light": "#18181B",
      "use": "Active icons, links"
    },
    "--accent-soft": {
      "dark": "rgba(255,255,255,0.12)",
      "light": "rgba(24,24,27,0.08)",
      "use": "Active and hover fills"
    },
    "--on-accent": {
      "dark": "#18181A",
      "light": "#FFFFFF",
      "use": "Check on a filled box"
    },
    "--selection": {
      "dark": "rgba(255,255,255,0.18)",
      "light": "rgba(24,24,27,0.14)",
      "use": "Text selection"
    },
    "--focus-ring": {
      "dark": "rgba(255,255,255,0.55)",
      "light": "rgba(24,24,27,0.55)",
      "use": "Keyboard focus"
    },
    "--cursor": {
      "dark": "#E4E4E7",
      "light": "#27272A",
      "use": "Text and terminal cursor"
    },
    "--danger": {
      "dark": "#FF7B72",
      "light": "#C9302C",
      "use": "Errors \u00b7 7.0 / 5.2:1"
    },
    "--success": {
      "dark": "#7DD69A",
      "light": "#1F7A45",
      "use": "Saved, done \u00b7 10.1 / 5.2:1"
    },
    "--warning": {
      "dark": "#E6B673",
      "light": "#9A5B00",
      "use": "Warnings, find \u00b7 9.5 / 5.2:1"
    },
    "--island": {
      "dark": "rgba(35,35,38,0.88)",
      "light": "rgba(255,255,255,0.88)",
      "use": "Format island, with 20px blur"
    }
