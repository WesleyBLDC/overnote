{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "overnote",
  "title": "Overnote",
  "description": "An open-source, extensible floating Markdown notepad, one hotkey away, with local notes, daily backups, and one-command updates.",
  "icon": "extension-icon.png",
  "author": "wesleybldc",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "keywords": [
    "notes",
    "notepad",
    "markdown",
    "scratchpad",
    "floating",
    "quick notes"
  ],
  "private": true,
  "workspaces": [
    "packages/*",
    "editor"
  ],
  "commands": [
    {
      "name": "toggle-notes",
      "title": "Toggle Overnote",
      "description": "Show or hide the floating Overnote window.",
      "mode": "no-view",
      "keywords": [
        "notes",
        "open",
        "show",
        "hide",
        "window"
      ]
    },
    {
      "name": "create-note",
      "title": "Create Note",
      "description": "Create a note from text, the search bar, or the selected text, and open it.",
      "mode": "no-view",
      "keywords": [
        "new",
        "add",
        "capture",
        "quick note"
      ],
      "arguments": [
        {
          "name": "text",
          "type": "text",
          "placeholder": "Text",
          "required": false
        }
      ]
    },
    {
      "name": "search-notes",
      "title": "Search Notes",
      "description": "Search, open, copy, pin, and manage your notes.",
      "mode": "view",
      "keywords": [
        "find",
        "browse",
        "list",
        "notes"
      ]
    },
    {
      "name": "recently-deleted",
      "title": "Recently Deleted Notes",
      "description": "Restore deleted notes or remove them permanently.",
      "mode": "view",
      "keywords": [
        "trash",
        "restore",
        "recover",
        "deleted"
      ]
    },
    {
      "name": "check-for-updates",
      "title": "Check for Updates",
      "description": "Compare the installed Overnote with the latest GitHub release and copy the update command.",
      "mode": "no-view",
      "keywords": [
        "update",
        "upgrade",
        "version",
        "release",
        "new version"
      ]
    },
    {
      "name": "menu-bar",
      "title": "Overnote Menu Bar",
      "description": "Pinned and recent notes in the menu bar.",
      "mode": "menu-bar",
      "interval": "1m",
      "disabledByDefault": true,
      "keywords": [
        "menu bar",
        "status bar"
      ]
    }
  ],
  "dependencies": {
    "@overnote/core": "*",
    "@raycast/api": "^2.8.0",
    "@raycast/utils": "^2.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "prebuild": "bash scripts/prepare-assets.sh",
    "build": "ray build",
    "predev": "bash scripts/prepare-assets.sh",
    "dev": "ray develop",
    "build:editor": "npm run build -w editor",
    "build:helper": "bash scripts/build-helper.sh",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bash scripts/verify.sh",
    "install-extension": "bash scripts/install-extension.sh",
    "update-extension": "bash scripts/update-extension.sh",
    "prepare-store": "bash scripts/prepare-store.sh",
    "publish": "npx @raycast/api@latest publish"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  }
}
